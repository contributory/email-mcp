# ═══════════════════════════════════════════════════════
# Mail MCP — cấu hình môi trường (mặc định hướng tới Gmail)
# Copy file này thành `.env` rồi điền thông tin của bạn.
# ═══════════════════════════════════════════════════════

# ── IMAP (nhận email) ──────────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=you@gmail.com
IMAP_PASSWORD=your-app-password

# ── SMTP (gửi email) ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
# Địa chỉ hiển thị trong ô "From" (mặc định = SMTP_USER)
SMTP_FROM=you@gmail.com

# ── Web UI ─────────────────────────────────────────────
PORT=3000

# File lưu cài đặt khi thay đổi qua Web UI (mặc định .mail-settings.json)
# SETTINGS_FILE=/path/to/mail-settings.json
